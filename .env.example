# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun. .env asla repoya girmez.

# Firebase Console > Proje ayarları > Genel > Web uygulaması (firebaseConfig)
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NUXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Console > Proje ayarları > Hizmet hesapları > Yeni özel anahtar oluştur
# İndirilen JSON dosyasının içeriği TEK SATIR olarak, tek tırnak içinde:
NUXT_FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project",...}'
